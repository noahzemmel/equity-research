# SQLite local DB
DATABASE_URL="file:./dev.db"

# LLM providers — set at least one. The app falls back to a deterministic
# offline stub if neither key is present, so the UI is still usable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto   # auto | openai | anthropic | offline
LLM_MODEL=          # optional override, e.g. gpt-4o-mini or claude-sonnet-4-6

# Optional web research enrichment
TAVILY_API_KEY=

# SEC EDGAR requires a contact header per their fair-use policy.
SEC_USER_AGENT="ai-equity-research-agent (contact@example.com)"

# Paper trading defaults
PAPER_STARTING_CASH=100000
PAPER_COMMISSION_BPS=2     # 2 bps per side
PAPER_SLIPPAGE_BPS=5       # 5 bps slippage assumption

# Background job auth — any non-empty string so an attacker can't trigger jobs
JOBS_SECRET="change-me-locally"

# In-process scheduler (set to "1" to enable a periodic refresh during dev)
SCHEDULER_ENABLED=0
SCHEDULER_INTERVAL_MINUTES=30
